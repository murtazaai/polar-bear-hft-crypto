// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Clean polar-bear-hft-crypto",
    "build": {
      "command": "cargo",
      "args": ["clean"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-hft-crypto",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Build & Debug polar-bear-hft-crypto",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-hft-crypto",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Release Build & Debug polar-bear-hft-crypto",
    "build": {
      "command": "cargo",
      "args": ["build", "--release"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/release/polar-bear-hft-crypto",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Rig AI agent module - Build & Debug polar-bear-hft-crypto ",
    "build": {
      "command": "cargo",
      "args": ["build", "--features", "ai-agent"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-hft-crypto",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Type-check only; no linking polar-bear-hft-crypto",
    "build": {
      "command": "cargo",
      "args": ["check"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-hft-crypto",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
]
