// polar-bear-hft-crypto - Zed task runner
// Rust HFT cryptographic signing layer · 7 exchanges · ECDSA/Ed25519/HMAC
//
// Key: tasks are ordered from fastest (check/fmt) → slowest (release/doc),
//      grouping exchange layer, crypto layer, and agent layer separately.
[
    // ── Quick feedback ─────────────────────────────────────────────────────────
    {
        "label": "check - all targets (fast)",
        "command": "cargo",
        "args": [
            "check",
            "--all-targets"
        ],
        "env": {
            "CARGO_INCREMENTAL": "1",
            "RUST_BACKTRACE": "short"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    {
        "label": "check - ai-agent feature",
        "command": "cargo",
        "args": [
            "check",
            "--all-targets",
            "--features",
            "ai-agent"
        ],
        "env": {
            "CARGO_INCREMENTAL": "1",
            "RUST_BACKTRACE": "short"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    // ── Formatting ─────────────────────────────────────────────────────────────
    {
        "label": "fmt - format all (rustfmt edition=2024)",
        "command": "cargo",
        "args": [
            "fmt",
            "--all"
        ],
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    {
        "label": "fmt - check only (CI mode)",
        "command": "cargo",
        "args": [
            "fmt",
            "--all",
            "--",
            "--check"
        ],
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    // ── Linting ────────────────────────────────────────────────────────────────
    {
        "label": "clippy - strict (all targets, -D warnings)",
        "command": "cargo",
        "args": [
            "clippy",
            "--all-targets",
            "--",
            "-D",
            "warnings",
            "-A",
            "clippy::module_name_repetitions",
            "-A",
            "clippy::must_use_candidate",
            "-A",
            "clippy::missing_errors_doc"
        ],
        "env": {
            "CARGO_INCREMENTAL": "1"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    {
        "label": "clippy - ai-agent feature (strict)",
        "command": "cargo",
        "args": [
            "clippy",
            "--all-targets",
            "--features",
            "ai-agent",
            "--",
            "-D",
            "warnings",
            "-A",
            "clippy::module_name_repetitions",
            "-A",
            "clippy::must_use_candidate",
            "-A",
            "clippy::missing_errors_doc"
        ],
        "env": {
            "CARGO_INCREMENTAL": "1"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    // ── Build ──────────────────────────────────────────────────────────────────
    {
        "label": "build - dev",
        "command": "cargo",
        "args": [
            "build"
        ],
        "env": {
            "CARGO_INCREMENTAL": "1",
            "RUST_BACKTRACE": "1"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    {
        "label": "build - release (native CPU, LTO)",
        "command": "cargo",
        "args": [
            "build",
            "--release"
        ],
        "env": {
            // Disable incremental for release - matches [profile.release] lto=true
            "CARGO_INCREMENTAL": "0",
            // native optimisations (AVX2 etc.) for the signing hot-path
            "RUSTFLAGS": "-C target-cpu=native"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    {
        "label": "build - ai-agent feature (dev)",
        "command": "cargo",
        "args": [
            "build",
            "--features",
            "ai-agent"
        ],
        "env": {
            "CARGO_INCREMENTAL": "1",
            "RUST_BACKTRACE": "1"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    {
        "label": "build - all features (docs.rs parity)",
        "command": "cargo",
        "args": [
            "build",
            "--all-features"
        ],
        "env": {
            "CARGO_INCREMENTAL": "1",
            "RUST_BACKTRACE": "1"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    // ── Tests ──────────────────────────────────────────────────────────────────
    {
        "label": "test - workspace (8 threads)",
        "command": "cargo",
        "args": [
            "test",
            "--workspace",
            "--",
            "--test-threads=8"
        ],
        "env": {
            "RUST_LOG": "polar_bear_hft_crypto=debug",
            "RUST_BACKTRACE": "1"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    {
        "label": "test - workspace with stdout (--nocapture)",
        "command": "cargo",
        "args": [
            "test",
            "--workspace",
            "--",
            "--nocapture",
            "--test-threads=4"
        ],
        "env": {
            "RUST_LOG": "polar_bear_hft_crypto=debug",
            "RUST_BACKTRACE": "1"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": true,
        "reveal": "always"
    },
    {
        "label": "test - crypto primitives (ECDSA · Ed25519 · HMAC)",
        "command": "cargo",
        "args": [
            "test",
            "--test",
            "crypto_tests",
            "--",
            "--nocapture"
        ],
        "env": {
            "RUST_LOG": "polar_bear_hft_crypto=debug",
            "RUST_BACKTRACE": "1"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    {
        "label": "test - 7-exchange auth adapters",
        "command": "cargo",
        "args": [
            "test",
            "--test",
            "exchange_auth_tests",
            "--",
            "--nocapture"
        ],
        "env": {
            "RUST_LOG": "polar_bear_hft_crypto=debug",
            "RUST_BACKTRACE": "1"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    {
        "label": "test - Anthropic live provider (requires ANTHROPIC_API_KEY)",
        "command": "cargo",
        "args": [
            "test",
            "--test",
            "providers",
            "--features",
            "ai-agent",
            "--",
            "--ignored",
            "--test-threads=1",
            "--nocapture"
        ],
        "env": {
            "RUST_LOG": "polar_bear_hft_crypto=debug,rig_core=info",
            "RUST_BACKTRACE": "1"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": true,
        "reveal": "always"
