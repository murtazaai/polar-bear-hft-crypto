    // ── Documentation ──────────────────────────────────────────────────────────
    {
        "label": "doc - all features (docs.rs mode, open in browser)",
        "command": "cargo",
        "args": [
            "doc",
            "--all-features",
            "--no-deps",
            "--open",
            "--document-private-items"
        ],
        "env": {
            "RUSTDOCFLAGS": "--cfg docsrs"
        },
        "allow_concurrent_runs": false,
        "use_new_terminal": false,
        "reveal": "always"
    },
    {
        "label": "doc - default features only",
        "command": "cargo",
        "args": [
            "doc",
            "--no-deps",
